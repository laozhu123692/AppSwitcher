    <string name="app_name">双App轮换切换</string>

    <!-- 主界面 -->
    <string name="main_intro">让任意两个已安装的 App 自动前后台轮换：A 前台停留一段时间 → B 前台停留同样时间 → 再切回 A……\n只切换前后台，不重启进程、不使用 root、不需要电脑。</string>

